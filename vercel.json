{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!assets/|sll-loader\\.js|vidlytics-widget\\.js|livecommerce-widget\\.js|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sll-loader|vidlytics-widget|livecommerce-widget).js",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}