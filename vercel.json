{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "black.useanny.com" }],
      "destination": "/black-mgrq",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/p/:store/:slug", "destination": "/api/page?store=:store&slug=:slug" },
    {
      "source": "/:slug",
      "has": [{ "type": "host", "value": "(?!app\\.sllhub\\.com\\.br$|.*\\.vercel\\.app$).*" }],
      "destination": "/api/page?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
